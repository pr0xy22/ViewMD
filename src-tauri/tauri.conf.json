{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViewMD",
  "version": "0.1.0",
  "identifier": "app.learn.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ViewMD",
        "width": 1080,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "backgroundColor": "#100f0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "A quiet, live Markdown previewer",
    "longDescription": "Learn opens a Markdown file and refreshes the preview whenever it changes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
